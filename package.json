{
  "name": "recipeat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:database": "node --experimental-strip-types --test tests/database.node.ts",
    "test:database:live": "node --experimental-strip-types --test tests/database.live.ts",
    "test:extraction": "node --experimental-strip-types --test tests/extraction.node.ts",
    "test:recipes": "node --experimental-strip-types --test tests/recipes.node.ts tests/recipeText.node.ts tests/recipeDraft.node.ts tests/recipeScale.node.ts tests/recipeDiff.node.ts tests/collections.node.ts tests/tags.node.ts tests/preferences.node.ts tests/recipeFilters.node.ts tests/lineageLayout.node.ts tests/siteSupport.node.ts tests/similar.node.ts tests/images.node.ts tests/ingredients.node.ts"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "kysely": "^0.29.6",
    "kysely-postgres-js": "^5.0.1",
    "nuxt": "^4.0.0",
    "nuxt-oidc-auth": "^1.0.0-beta.12",
    "pluralize": "^8.0.0",
    "postgres": "^3.4.9",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/pluralize": "^0.0.33"
  }
